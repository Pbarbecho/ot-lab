{
  "server": {
    "listenerAddress": "0.0.0.0",
    "listenerPort": 5020,
    "protocol": "TCP",
    "tlsParams": { "privateKey": null, "certificate": null },
    "logging": {
      "format": "%(asctime)-15s %(levelname)-8s %(message)s",
      "logLevel": "INFO"
    }
  },
  "persistence": { "enabled": false, "file": "/data/modbus_registers.json", "saveInterval": 30 },
  "metrics": { "enabled": false, "address": "0.0.0.0", "port": 9090, "path": "/metrics" },
  "registers": {
    "description": "Claves = offset de protocolo (0-based). HR 0..2 -> [1234, 25, 72]; IR 0 -> 999",
    "initializeUndefinedRegisters": true,
    "discreteInput":   { "0": true, "1": false },
    "coils":           { "0": false, "1": true },
    "holdingRegister": { "0": 1234, "1": 25, "2": 72 },
    "inputRegister":   { "0": 999 }
  }
}
